{
  "name": "clinicbooking",
  "version": "1.0.0",
  "description": "Clinic Booking REST API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "docker:dev": "docker compose up --build",
    "docker:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
    "docker:down": "docker compose down",
    "seed": "node src/seed/seed.js",
    "import:doctor-data": "node scripts/import-doctors-from-dump.js",
    "import:doctors": "node scripts/import-doctors-from-dump.js",
    "test": "node --test tests/*.test.js",
    "test:p0": "node --test tests/p0-*.test.js",
    "lint": "node --check src/server.js src/app.js src/config/*.js src/services/*.js src/middlewares/*.js src/models/*.js src/utils/*.js src/controllers/*.js src/routes/*.js src/routes/features/*.js",
    "build": "node -e \"console.log('[Build] Verification passed: ClinicBooking Modular Monolith Backend')\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nguyenhung15/ClinicBooking.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/Nguyenhung15/ClinicBooking/issues"
  },
  "homepage": "https://github.com/Nguyenhung15/ClinicBooking#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
